<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="robot_nav_field">

    <!-- ======================= 物理引擎 ======================= -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================= 场景与光照 ======================= -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ============================================================
         1. 地面 (Ground Plane)  —— 7m x 7m
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>2.975 -2.8 -0.025 0 0 0</pose>
      <link name="ground_link">
        <visual name="ground_visual">
          <geometry><box><size>7.0 7.0 0.05</size></box></geometry>
          <material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse></material>
        </visual>
        <collision name="ground_collision">
          <geometry><box><size>7.0 7.0 0.05</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         2. 外部围墙 (Boundary Walls)  —— 高 0.5m
         ============================================================ -->
    <model name="boundary_walls">
      <static>true</static>
      <link name="north_wall">
        <pose>-0.525 -2.8 0.25 0 0 0</pose>
        <visual name="north_visual"><geometry><box><size>0.1 7.0 0.5</size></box></geometry><material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material></visual>
        <collision name="north_collision"><geometry><box><size>0.1 7.0 0.5</size></box></geometry></collision>
      </link>
      <link name="south_wall">
        <pose>6.475 -2.8 0.25 0 0 0</pose>
        <visual name="south_visual"><geometry><box><size>0.1 7.0 0.5</size></box></geometry><material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material></visual>
        <collision name="south_collision"><geometry><box><size>0.1 7.0 0.5</size></box></geometry></collision>
      </link>
      <link name="west_wall">
        <pose>2.975 -6.3 0.25 0 0 0</pose>
        <visual name="west_visual"><geometry><box><size>7.0 0.1 0.5</size></box></geometry><material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material></visual>
        <collision name="west_collision"><geometry><box><size>7.0 0.1 0.5</size></box></geometry></collision>
      </link>
      <link name="east_wall">
        <pose>2.975 0.7 0.25 0 0 0</pose>
        <visual name="east_visual"><geometry><box><size>7.0 0.1 0.5</size></box></geometry><material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material></visual>
        <collision name="east_collision"><geometry><box><size>7.0 0.1 0.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============================================================
         3. 道路 (60cm 宽, 0.6m)
         环形外围: 顶部 road_top / 右侧 road_right / 底部 road_bottom_left / 左侧 road_left
         内部 L 形: 纵向 road_vertical (楼宇西侧) / 横向 road_horizontal (街区A上方)
         ============================================================ -->
    <model name="roads">
      <static>true</static>
      <!-- 顶部通道 -->
      <link name="road_top">
        <pose>0 -2.7 0.005 0 0 0</pose>
        <visual name="road_top_visual"><geometry><box><size>0.6 4.2 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_top_collision"><geometry><box><size>0.6 3.6 0.01</size></box></geometry></collision>
      </link>
      <!-- 右侧通道 (南北两端对齐顶部/底部道路, X 0~5.5) -->
      <link name="road_right">
        <pose>2.75 -0.9 0.005 0 0 0</pose>
        <visual name="road_right_visual"><geometry><box><size>5.5 0.6 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_right_collision"><geometry><box><size>5.5 0.6 0.01</size></box></geometry></collision>
      </link>
      <!-- 底部横向通道 -->
      <link name="road_bottom_left">
        <pose>5.5 -2.7 0.005 0 0 0</pose>
        <visual name="road_bl_visual"><geometry><box><size>0.6 4.2 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_bl_collision"><geometry><box><size>0.6 3.6 0.01</size></box></geometry></collision>
      </link>
      <!-- 左侧街道 (南北两端对齐顶部/底部道路, X 0~5.5) -->
      <link name="road_left">
        <pose>2.75 -4.5 0.005 0 0 0</pose>
        <visual name="road_left_visual"><geometry><box><size>5.5 0.6 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_left_collision"><geometry><box><size>5.5 0.6 0.01</size></box></geometry></collision>
      </link>
      <!-- ===== 新增 L 形内部路 ===== -->
      <!-- 纵向路: 楼宇西侧, Y=-2.5, X 2.1 -> 5.5 (北端止于横向路拐角) -->
      <link name="road_vertical">
        <pose>3.2 -2.5 0.005 0 0 0</pose>
        <visual name="road_vertical_visual"><geometry><box><size>4.6 0.6 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_vertical_collision"><geometry><box><size>3.4 0.6 0.01</size></box></geometry></collision>
      </link>
      <!-- 横向路: A/B街区之间, X=2.1, Y -2.5 -> -4.5 -->
      <link name="road_horizontal">
        <pose>1.2 -3.5 0.005 0 0 0</pose>
        <visual name="road_horizontal_visual"><geometry><box><size>0.6 2.0 0.01</size></box></geometry><material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <collision name="road_horizontal_collision"><geometry><box><size>0.6 2.0 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============================================================
         4. 起点/终点区  —— 斑马线, 中心 (0,0,0), 右上角
         ============================================================ -->
    <model name="start_finish">
      <static>true</static>
      <link name="zebra_link">
        <visual name="zebra_base">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.012</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <collision name="zebra_base_col">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.012</size></box></geometry>
        </collision>
        <visual name="stripe_1"><pose>0 -0.48 0.013 0 0 0</pose><geometry><box><size>1.0 0.12 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_2"><pose>0 -0.24 0.013 0 0 0</pose><geometry><box><size>1.0 0.12 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_3"><pose>0 0 0.013 0 0 0</pose><geometry><box><size>1.0 0.12 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_4"><pose>0 0.24 0.013 0 0 0</pose><geometry><box><size>1.0 0.12 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_5"><pose>0 0.48 0.013 0 0 0</pose><geometry><box><size>1.0 0.12 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         5. 顶部斑马线(中央上侧)  —— (0, -3.3)
         黑白等宽条纹, 宽 0.6m, 行人南->北跨越, 条纹东西向长边
         ============================================================ -->
    <model name="zebra_top">
      <static>true</static>
      <pose>0 -3.3 0 0 0 0</pose>
      <link name="zebra_top_link">
        <visual name="base">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.6 1.2 0.012</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="base_col">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.6 1.2 0.012</size></box></geometry>
        </collision>
        <visual name="w1"><pose>-0.25 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="k1"><pose>-0.15 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        <visual name="w2"><pose>-0.05 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="k2"><pose>0.05 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
        <visual name="w3"><pose>0.15 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="k3"><pose>0.25 0 0.013 0 0 0</pose><geometry><box><size>0.1 1.2 0.014</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      </link>
    </model>

    <model name="traffic_light_top">
      <static>true</static>
      <link name="tl_top_link">
        <visual name="pole_visual">
          <pose>-0.5 -3.3 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="pole_col">
          <pose>-0.5 -3.3 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="housing_visual">
          <pose>-0.5 -3.3 0.62 0 0 0</pose>
          <geometry><box><size>0.10 0.14 0.40</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <collision name="housing_col">
          <pose>-0.5 -3.3 0.62 0 0 0</pose>
          <geometry><box><size>0.10 0.14 0.40</size></box></geometry>
        </collision>
        <visual name="red_visual"><pose>-0.43 -3.3 0.76 0 0 0</pose><geometry><box><size>0.03 0.09 0.09</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="yellow_visual"><pose>-0.43 -3.3 0.64 0 0 0</pose><geometry><box><size>0.03 0.09 0.09</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <visual name="green_visual"><pose>-0.43 -3.3 0.52 0 0 0</pose><geometry><box><size>0.03 0.09 0.09</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         6. A街区 (左上角人偶区)  —— 6 个人偶, 移至横向路下方 (1.4, -3.85)
         ============================================================ -->
    <model name="block_a">
      <static>true</static>
      <pose>0.7 -3.85 0 0 0 0</pose>
      <link name="block_a_link">
        <visual name="sidewalk">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.01</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
        <collision name="sidewalk_col">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.01</size></box></geometry>
        </collision>
        <!-- p1 红 -->
        <visual name="p1_body"><pose>-0.15 -0.2 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.90 0.20 0.20 1</ambient><diffuse>0.90 0.20 0.20 1</diffuse></material></visual>
        <visual name="p1_head"><pose>-0.15 -0.2 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
        <!-- p2 蓝 -->
        <visual name="p2_body"><pose>-0.15 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.20 0.40 0.90 1</ambient><diffuse>0.20 0.40 0.90 1</diffuse></material></visual>
        <visual name="p2_head"><pose>-0.15 0 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
        <!-- p3 黄 -->
        <visual name="p3_body"><pose>-0.15 0.2 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.95 0.85 0.20 1</ambient><diffuse>0.95 0.85 0.20 1</diffuse></material></visual>
        <visual name="p3_head"><pose>-0.15 0.2 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
        <!-- p4 绿 -->
        <visual name="p4_body"><pose>0.15 -0.2 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.20 0.60 0.30 1</ambient><diffuse>0.20 0.60 0.30 1</diffuse></material></visual>
        <visual name="p4_head"><pose>0.15 -0.2 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
        <!-- p5 紫 -->
        <visual name="p5_body"><pose>0.15 0 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.60 0.25 0.75 1</ambient><diffuse>0.60 0.25 0.75 1</diffuse></material></visual>
        <visual name="p5_head"><pose>0.15 0 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
        <!-- p6 青 -->
        <visual name="p6_body"><pose>0.15 0.2 0.07 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.14</length></cylinder></geometry><material><ambient>0.15 0.60 0.70 1</ambient><diffuse>0.15 0.60 0.70 1</diffuse></material></visual>
        <visual name="p6_head"><pose>0.15 0.2 0.19 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.95 0.75 0.60 1</ambient><diffuse>0.95 0.75 0.60 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         7. B街区 (左侧中部人偶区)  —— 6 个人偶 (2.8, -4.03)
         ============================================================ -->
    <model name="block_b">
      <static>true</static>
      <pose>2.8 -3.7 0 0 0 0</pose>
      <link name="block_b_link">
        <visual name="sidewalk">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.01</size></box></geometry>
