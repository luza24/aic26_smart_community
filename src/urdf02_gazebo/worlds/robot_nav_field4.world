    <!-- ============================================================
         8. 楼宇 A / B / C  —— 长宽减半(0.35), A 不变, 间距减半(0.44)
         A (2.10, -1.75) / B (2.54, -1.75) / C (2.98, -1.75)
         ============================================================ -->
    <model name="building_a">
      <static>true</static>
      <pose>2.10 -1.75 0 0 0 0</pose>
      <link name="building_a_link">
        <visual name="body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
          <material><ambient>0.10 0.55 0.25 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse></material>
        </visual>
        <collision name="body_col">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
        </collision>
        <visual name="roof">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><box><size>0.39 0.39 0.04</size></box></geometry>
          <material><ambient>0.08 0.42 0.20 1</ambient><diffuse>0.08 0.42 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_b">
      <static>true</static>
      <pose>2.54 -1.75 0 0 0 0</pose>
      <link name="building_b_link">
        <visual name="body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
          <material><ambient>0.10 0.55 0.25 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse></material>
        </visual>
        <collision name="body_col">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.5</size></box></geometry>
        </collision>
        <visual name="roof">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><box><size>0.39 0.39 0.04</size></box></geometry>
