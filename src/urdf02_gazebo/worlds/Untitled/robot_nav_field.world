<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="robot_nav_field">

    <!-- ======================= 物理引擎 ======================= -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================= 场景与光照 ======================= -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ============================================================
         1. 地面 (Ground Plane)  —— 7.5m x 5m, 上表面在 z=0
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>2.75 0 -0.025 0 0 0</pose>
      <link name="ground_link">
        <visual name="ground_visual">
          <geometry>
            <box><size>7.5 5.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.70 0.70 0.70 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="ground_collision">
          <geometry>
            <box><size>7.5 5.0 0.05</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         2. 外部围墙 (Boundary Walls)  —— 高 0.5m, 防机器人跑出
         ============================================================ -->
    <model name="boundary_walls">
      <static>true</static>
      <!-- 北墙 (顶部, X=-1.0) -->
      <link name="north_wall">
        <pose>-1.0 0 0.25 0 0 0</pose>
        <visual name="north_visual">
          <geometry><box><size>0.1 5.0 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="north_collision">
          <geometry><box><size>0.1 5.0 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 南墙 (底部, X=6.5) -->
      <link name="south_wall">
        <pose>6.5 0 0.25 0 0 0</pose>
        <visual name="south_visual">
          <geometry><box><size>0.1 5.0 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="south_collision">
          <geometry><box><size>0.1 5.0 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 西墙 (左侧, Y=-2.5) -->
      <link name="west_wall">
        <pose>2.75 -2.5 0.25 0 0 0</pose>
        <visual name="west_visual">
          <geometry><box><size>7.5 0.1 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <geometry><box><size>7.5 0.1 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 东墙 (右侧, Y=2.5) -->
      <link name="east_wall">
        <pose>2.75 2.5 0.25 0 0 0</pose>
        <visual name="east_visual">
          <geometry><box><size>7.5 0.1 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <geometry><box><size>7.5 0.1 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         3. 道路 (Roads)  —— 核心道路宽 0.6m, 环形
         右侧主干道 Y≈1.2, 左侧主干道 Y≈-1.2, 顶部/底部横向连接
         ============================================================ -->
    <model name="roads">
      <static>true</static>
      <!-- 右侧主干道 -->
      <link name="road_right">
        <pose>2.9 1.2 0.005 0 0 0</pose>
        <visual name="road_right_visual">
          <geometry><box><size>6.6 0.6 0.01</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="road_right_collision">
          <geometry><box><size>6.6 0.6 0.01</size></box></geometry>
        </collision>
      </link>
      <!-- 左侧主干道 -->
      <link name="road_left">
        <pose>2.9 -1.2 0.005 0 0 0</pose>
        <visual name="road_left_visual">
          <geometry><box><size>6.6 0.6 0.01</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="road_left_collision">
          <geometry><box><size>6.6 0.6 0.01</size></box></geometry>
        </collision>
      </link>
      <!-- 顶部横向道路 (起点区) -->
      <link name="road_top">
        <pose>0 0 0.005 0 0 0</pose>
        <visual name="road_top_visual">
          <geometry><box><size>0.6 2.4 0.01</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="road_top_collision">
          <geometry><box><size>0.6 2.4 0.01</size></box></geometry>
        </collision>
      </link>
      <!-- 底部横向道路 (底部红绿灯路口) -->
      <link name="road_bottom">
        <pose>6.0 0 0.005 0 0 0</pose>
        <visual name="road_bottom_visual">
          <geometry><box><size>0.6 2.4 0.01</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="road_bottom_collision">
          <geometry><box><size>0.6 2.4 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         4. 起点/终点区 (Start/Finish)  —— 斑马线, 中心 (0,0,0)
         ============================================================ -->
    <model name="zebra_crossing">
      <static>true</static>
      <link name="zebra_link">
        <!-- 深色底板 -->
        <visual name="zebra_base">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.8 1.2 0.012</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <collision name="zebra_base_col">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.8 1.2 0.012</size></box></geometry>
        </collision>
        <!-- 白色斑马条纹 (沿 Y 方向排布 5 条) -->
        <visual name="zebra_stripe_1">
          <pose>0 -0.48 0.013 0 0 0</pose>
          <geometry><box><size>0.8 0.12 0.014</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="zebra_stripe_2">
          <pose>0 -0.24 0.013 0 0 0</pose>
          <geometry><box><size>0.8 0.12 0.014</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="zebra_stripe_3">
          <pose>0 0 0.013 0 0 0</pose>
          <geometry><box><size>0.8 0.12 0.014</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="zebra_stripe_4">
          <pose>0 0.24 0.013 0 0 0</pose>
          <geometry><box><size>0.8 0.12 0.014</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="zebra_stripe_5">
          <pose>0 0.48 0.013 0 0 0</pose>
          <geometry><box><size>0.8 0.12 0.014</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         5. 顶部红绿灯  —— 立杆 + 红黄绿三灯, 位于起点线正前方 (-X)
         ============================================================ -->
    <model name="traffic_light_top">
      <static>true</static>
      <link name="tl_top_link">
        <!-- 立杆 -->
        <visual name="pole_visual">
          <pose>-0.6 0 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="pole_col">
          <pose>-0.6 0 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <!-- 灯箱 -->
        <visual name="housing_visual">
          <pose>-0.6 0 0.62 0 0 0</pose>
          <geometry><box><size>0.10 0.14 0.40</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <collision name="housing_col">
          <pose>-0.6 0 0.62 0 0 0</pose>
          <geometry><box><size>0.10 0.14 0.40</size></box></geometry>
        </collision>
        <!-- 红灯 (上) -->
        <visual name="red_visual">
          <pose>-0.53 0 0.76 0 0 0</pose>
          <geometry><box><size>0.03 0.09 0.09</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- 黄灯 (中) -->
        <visual name="yellow_visual">
          <pose>-0.53 0 0.64 0 0 0</pose>
          <geometry><box><size>0.03 0.09 0.09</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
        <!-- 绿灯 (下) -->
        <visual name="green_visual">
          <pose>-0.53 0 0.52 0 0 0</pose>
          <geometry><box><size>0.03 0.09 0.09</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

