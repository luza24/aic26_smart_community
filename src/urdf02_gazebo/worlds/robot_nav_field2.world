        </visual>
        <collision name="east_collision">
          <geometry><box><size>7.0 0.1 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         3. 道路 (60cm 通道, 宽 0.6m)
         左侧通道 (A/B街区旁)   : Y = -4.5, 纵向
         右侧通道 (楼宇/停车位旁): Y = -0.9, 纵向
         左下通道 (楼宇D旁)     : X =  5.5, 横向
         顶部通道 (起点/红绿灯) : X =  0.0, 横向 (补全环形)
         ============================================================ -->
