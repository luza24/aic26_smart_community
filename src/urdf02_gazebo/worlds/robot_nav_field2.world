<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="robot_nav_field">

    <!-- ======================= 物理引擎 ======================= -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================= 场景与光照 ======================= -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ============================================================
         1. 地面 (Ground Plane)  —— 7m x 7m, 上表面在 z=0
         世界范围: X ∈ [-0.525, 6.475], Y ∈ [-6.3, 0.7]
         中心: (2.975, -2.8)
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>2.975 -2.8 -0.025 0 0 0</pose>
      <link name="ground_link">
        <visual name="ground_visual">
          <geometry>
            <box><size>7.0 7.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.70 0.70 0.70 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="ground_collision">
          <geometry>
            <box><size>7.0 7.0 0.05</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         2. 外部围墙 (Boundary Walls)  —— 高 0.5m, 防机器人跑出
         ============================================================ -->
    <model name="boundary_walls">
      <static>true</static>
      <!-- 北墙 (顶部, X=-0.525) -->
      <link name="north_wall">
        <pose>-0.525 -2.8 0.25 0 0 0</pose>
        <visual name="north_visual">
          <geometry><box><size>0.1 7.0 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="north_collision">
          <geometry><box><size>0.1 7.0 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 南墙 (底部, X=6.475) -->
      <link name="south_wall">
        <pose>6.475 -2.8 0.25 0 0 0</pose>
        <visual name="south_visual">
          <geometry><box><size>0.1 7.0 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="south_collision">
          <geometry><box><size>0.1 7.0 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 西墙 (左侧, Y=-6.3) -->
      <link name="west_wall">
        <pose>2.975 -6.3 0.25 0 0 0</pose>
        <visual name="west_visual">
          <geometry><box><size>7.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.50 0.50 0.55 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <geometry><box><size>7.0 0.1 0.5</size></box></geometry>
        </collision>
      </link>
      <!-- 东墙 (右侧, Y=0.7) -->
      <link name="east_wall">
        <pose>2.975 0.7 0.25 0 0 0</pose>
        <visual name="east_visual">
          <geometry><box><size>7.0 0.1 0.5</size></box></geometry>
