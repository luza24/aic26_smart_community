<launch>
    <node pkg="turtlesim" type="turtlesim_node" name="turtle1" output="screen"/>
    <node pkg="turtlesim" type="turtle_teleop_key" name="key" output="screen"/>
    <node pkg="tf04_test" type="new_turtle" name="turtle2" output="screen"/>
    <node pkg="tf04_test" type="turtle_pub" name="turtle_pub" args="turtle1" output="screen"/>
    <node pkg="tf04_test" type="turtle_pub" name="turtle_pub1" args="turtle2" output="screen"/>
    <node pkg="tf04_test" type="turtle_sub" name="turtle_sub" output="screen"/>

</launch>    